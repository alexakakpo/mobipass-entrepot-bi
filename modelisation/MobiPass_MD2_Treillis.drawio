<mxfile host="app.diagrams.net"><diagram name="MD2 treillis partiel" id="treillis"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;MD2 Ventes : treillis partiel des agrégats&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nœuds notés (Produit_MD, Employe_MD, Metier_MD, Temps_MD) ; All = dimension totalement agrégée&lt;/i&gt;" style="text;html=1;align=center;fontSize=16;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="45" as="geometry"/></mxCell><mxCell id="t2" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#D9D9D9;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1020" height="150" as="geometry"/></mxCell><mxCell id="t3" value="Analyses" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="200" height="24" as="geometry"/></mxCell><mxCell id="t4" value="" style="rounded=0;html=1;fillColor=#FFFDF5;strokeColor=#D9D9D9;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="1020" height="330" as="geometry"/></mxCell><mxCell id="t5" value="Données agrégées" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="200" height="24" as="geometry"/></mxCell><mxCell id="t6" value="" style="rounded=0;html=1;fillColor=#F2F6FA;strokeColor=#D9D9D9;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="590" width="1020" height="110" as="geometry"/></mxCell><mxCell id="t7" value="Données détaillées" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="200" height="24" as="geometry"/></mxCell><mxCell id="t8" value="Treillis&lt;br&gt;partiel" style="text;html=1;align=center;fontSize=13;fontStyle=3;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="80" height="50" as="geometry"/></mxCell><mxCell id="t9" value="&lt;b&gt;A1 (B4.1)&lt;/b&gt; Sum(Quantite_Achat_MD), Sum(Montant_Achat_ReelPaye_MD), Sum(Benefice_Achat_MD)&lt;br&gt;Mois (comparé à l'année précédente)&lt;br&gt;CodePays (NomPays)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="300" height="95" as="geometry"/></mxCell><mxCell id="t10" value="&lt;b&gt;A2 (B4.2)&lt;/b&gt; Sum(Montant_Achat_ReelPaye_MD) : classement&lt;br&gt;Mois&lt;br&gt;CodeGamme (NomGamme)&lt;br&gt;CodeRegion (NomRegion)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="270" height="95" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b&gt;A3 (B4.3)&lt;/b&gt; Sum(Quantite_Achat_MD), Sum(Montant_Achat_ReelPaye_MD), Sum(Benefice_Achat_MD)&lt;br&gt;Mois&lt;br&gt;CodeTy, CodeCJ2 (LibelleCJ2)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="320" height="95" as="geometry"/></mxCell><mxCell id="t12" value="&lt;b&gt;(All, All, All, All)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="440" y="255" width="150" height="36" as="geometry"/></mxCell><mxCell id="t13" value="&lt;b&gt;(All, CodePays, All, Mois)&lt;/b&gt;&lt;br&gt;MV_ACH_PAYS_MOIS&lt;br&gt;&lt;i&gt;source : MV_ACH_GAM_REG_MOIS&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="260" height="65" as="geometry"/></mxCell><mxCell id="t14" value="&lt;b&gt;(CodeGamme, CodeRegion, All, Mois)&lt;/b&gt;&lt;br&gt;MV_ACH_GAM_REG_MOIS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="230" y="470" width="270" height="55" as="geometry"/></mxCell><mxCell id="t15" value="&lt;b&gt;(All, CodeTy x CodeCJ2, All, Mois)&lt;/b&gt;&lt;br&gt;MV_ACH_TYPE_CJ_MOIS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="300" height="55" as="geometry"/></mxCell><mxCell id="t16" value="&lt;b&gt;(CodeProduit, IdVersionEmploye, CodeAppellation, DateJour)&lt;/b&gt;&lt;br&gt;Table de fait FAIT_ACHAT_MD2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="320" height="55" as="geometry"/></mxCell><mxCell id="t17" style="endArrow=block;endFill=1;html=1;strokeColor=#1F4E79;strokeWidth=1.5;" edge="1" parent="1" source="t16" target="t14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t18" style="endArrow=block;endFill=1;html=1;strokeColor=#1F4E79;strokeWidth=1.5;" edge="1" parent="1" source="t16" target="t15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t19" style="endArrow=block;endFill=1;html=1;strokeColor=#1F4E79;strokeWidth=1.5;" edge="1" parent="1" source="t14" target="t13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t20" style="endArrow=block;endFill=1;html=1;strokeColor=#1F4E79;strokeWidth=1.5;" edge="1" parent="1" source="t13" target="t12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t21" style="endArrow=block;endFill=1;html=1;strokeColor=#1F4E79;strokeWidth=1.5;" edge="1" parent="1" source="t15" target="t12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t22" style="endArrow=open;html=1;dashed=1;strokeColor=#808080;" edge="1" parent="1" source="t13" target="t9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t23" style="endArrow=open;html=1;dashed=1;strokeColor=#808080;" edge="1" parent="1" source="t14" target="t10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t24" style="endArrow=open;html=1;dashed=1;strokeColor=#808080;" edge="1" parent="1" source="t15" target="t11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t25" value="Chaque agrégat garde &lt;b&gt;CodePays&lt;/b&gt; : filtre par pays (sécurité RLS de Power BI) pour les responsables de Lyon et de Berlin." style="text;html=1;whiteSpace=wrap;align=left;fontSize=10;fontStyle=2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="660" y="480" width="330" height="45" as="geometry"/></mxCell><mxCell id="t26" value="&lt;b&gt;Lecture&lt;/b&gt; : une flèche pleine va d'un nœud vers un nœud plus agrégé calculable à partir de lui ; une flèche en pointillés relie un agrégat à l'analyse qu'il sert. Seuls les nœuds utiles aux rapports mensuels B4 sont matérialisés (vues matérialisées Oracle, REFRESH COMPLETE ON DEMAND), comme dans la démarche du cours : treillis complet (tous les agrégats possibles selon les hiérarchies), puis treillis partiel (agrégats choisis selon les besoins)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1010" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>